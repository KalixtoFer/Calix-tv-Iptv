rules_version = '2';

// Reglas de seguridad de Calix TV.
//  - config/servidor : cualquiera puede LEER ese único documento (la app lo necesita antes
//                      del login). Solo un administrador puede escribirlo.
//  - admins/{uid}    : un usuario solo puede ver su propio documento (así el panel sabe si
//                      es admin). Nadie puede escribirlo desde el cliente: se crea a mano
//                      desde Firebase Console.
//  - todo lo demás   : denegado.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /config/servidor {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
